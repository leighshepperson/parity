 import polars as pl
 
@@ -51,3 +51,31 @@ def ensure_polars_rolling_kwargs(kwargs: Dict[str, Any]) -> Dict[str, Any]:
         value = normalized.pop("min_samples")
         normalized.setdefault("min_periods", value)
     return normalized
+
+
+@lru_cache(maxsize=None)
+def _polars_ewm_supports_min_samples() -> bool:
+    """Return True if the current Polars EWM API accepts `min_samples`."""
+    try:
+        return "min_samples" in inspect.signature(pl.Expr.ewm_mean).parameters
+    except (TypeError, ValueError):
+        return False
+
+
+def ensure_polars_ewm_kwargs(
+    kwargs: Dict[str, Any], *, minimum_samples: Optional[int] = None
+) -> Dict[str, Any]:
+    """Translate the EWM minimum-observation keyword across Polars versions."""
+    normalized = dict(kwargs)
+    if _polars_ewm_supports_min_samples():
+        key = "min_samples"
+        if "min_periods" in normalized and key not in normalized:
+            normalized[key] = normalized.pop("min_periods")
+    else:
+        key = "min_periods"
+        if "min_samples" in normalized and key not in normalized:
+            normalized[key] = normalized.pop("min_samples")
+
+    if minimum_samples is not None:
+        normalized[key] = max(minimum_samples, normalized.get(key) or 0)
+    return normalized
