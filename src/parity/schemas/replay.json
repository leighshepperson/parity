{
  "$defs": {
    "InvocationArrowDocument": {
      "additionalProperties": false,
      "description": "One Arrow leaf in a replayable invocation document.",
      "properties": {
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "kind": {
          "const": "arrow",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "file"
      ],
      "title": "InvocationArrowDocument",
      "type": "object"
    },
    "InvocationDocument": {
      "additionalProperties": false,
      "description": "Stored recursive positional and keyword call contract.",
      "properties": {
        "args": {
          "items": {
            "discriminator": {
              "mapping": {
                "arrow": "#/$defs/InvocationArrowDocument",
                "frames": "#/$defs/InvocationFramesDocument",
                "json": "#/$defs/InvocationJsonDocument"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/InvocationArrowDocument"
              },
              {
                "$ref": "#/$defs/InvocationJsonDocument"
              },
              {
                "$ref": "#/$defs/InvocationFramesDocument"
              }
            ]
          },
          "maxItems": 256,
          "title": "Args",
          "type": "array"
        },
        "kwargs": {
          "additionalProperties": {
            "discriminator": {
              "mapping": {
                "arrow": "#/$defs/InvocationArrowDocument",
                "frames": "#/$defs/InvocationFramesDocument",
                "json": "#/$defs/InvocationJsonDocument"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/InvocationArrowDocument"
              },
              {
                "$ref": "#/$defs/InvocationJsonDocument"
              },
              {
                "$ref": "#/$defs/InvocationFramesDocument"
              }
            ]
          },
          "maxProperties": 256,
          "title": "Kwargs",
          "type": "object"
        }
      },
      "required": [
        "args",
        "kwargs"
      ],
      "title": "InvocationDocument",
      "type": "object"
    },
    "InvocationFramesDocument": {
      "additionalProperties": false,
      "description": "One list/tuple-valued frame argument in an invocation document.",
      "properties": {
        "container": {
          "enum": [
            "list",
            "tuple"
          ],
          "title": "Container",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/InvocationArrowDocument"
          },
          "maxItems": 256,
          "title": "Items",
          "type": "array"
        },
        "kind": {
          "const": "frames",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "container",
        "items"
      ],
      "title": "InvocationFramesDocument",
      "type": "object"
    },
    "InvocationJsonDocument": {
      "additionalProperties": false,
      "description": "One JSON leaf in a replayable invocation document.",
      "properties": {
        "kind": {
          "const": "json",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "InvocationJsonDocument",
      "type": "object"
    },
    "JsonValue": {},
    "ReplayPathBaseContract": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "artifact_ancestor",
          "title": "Kind",
          "type": "string"
        },
        "levels": {
          "maximum": 64,
          "minimum": 1,
          "title": "Levels",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "levels"
      ],
      "title": "ReplayPathBaseContract",
      "type": "object"
    }
  },
  "$id": "https://parity-check.dev/schemas/replay/v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Path-free replay document stored inside a finding artifact.",
  "properties": {
    "case": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Case",
      "type": "object"
    },
    "command": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command"
    },
    "config_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config Sha256"
    },
    "environment": {
      "title": "Environment",
      "type": "string"
    },
    "expected_runtime": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "invocation": {
      "$ref": "#/$defs/InvocationDocument"
    },
    "path_base": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReplayPathBaseContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "replay_blockers": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replay Blockers"
    },
    "version": {
      "const": 3,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "case",
    "environment",
    "invocation"
  ],
  "title": "ReplayContract",
  "type": "object",
  "x-parity-contract": "replay",
  "x-parity-contract-version": 3
}
