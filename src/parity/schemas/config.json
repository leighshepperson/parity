  "$id": "https://parity-check.dev/schemas/config/v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "not": {
            "required": [
              "cases_file"
            ]
          },
          "required": [
            "cases"
          ]
        },
        {
          "not": {
            "required": [
              "cases"
            ]
          },
          "required": [
            "cases_file"
          ]
        }
      ]
    }
  ],
  "description": "Structurally typed authoring contract for ``parity.toml``.",
  "properties": {
    "artifact_dir": {
      "default": ".parity",
      "format": "path",
      "title": "Artifact Dir",
      "type": "string"
    },
    "case_defaults": {
      "anyOf": [
        {
          "$ref": "#/$defs/_CaseDefaults"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cases": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/CaseConfig"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cases"
    },
    "cases_file": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cases File"
    },
    "compatibility_budget": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compatibility Budget"
    },
    "fail_fast": {
      "default": false,
      "title": "Fail Fast",
      "type": "boolean"
    },
    "jobs": {
      "default": 1,
      "maximum": 256,
      "minimum": 1,
      "title": "Jobs",
      "type": "integer"
    },
    "native_threads": {
      "anyOf": [
        {
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Threads"
    },
    "version": {
      "const": 2,
      "default": 2,
      "title": "Version",
      "type": "integer"
    }
  },
  "title": "ConfigContract",
  "type": "object",
  "x-parity-contract": "config",
  "x-parity-contract-version": 2
}
