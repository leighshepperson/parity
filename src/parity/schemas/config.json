{
  "$defs": {
    "CallableSpec": {
      "additionalProperties": false,
      "description": "One Python or protocol-command implementation and its environment.",
      "properties": {
        "adapter": {
          "default": "auto",
          "enum": [
            "auto",
            "pandas",
            "polars",
            "arrow"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "canonicalizer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonicalizer"
        },
        "command": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "native_threads": {
          "anyOf": [
            {
              "maximum": 256,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Threads"
        },
        "pandas_input": {
          "default": "arrow",
          "enum": [
            "arrow",
            "native"
          ],
          "title": "Pandas Input",
          "type": "string"
        },
        "python": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Python"
        },
        "record_distributions": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Record Distributions",
          "type": "array"
        },
        "required_distributions": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 64,
          "title": "Required Distributions",
          "type": "object"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "workdir": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workdir"
        }
      },
      "title": "CallableSpec",
      "type": "object"
    },
    "Cardinality": {
      "additionalProperties": false,
      "description": "Declare which side(s) of a relationship must have unique keys.",
      "properties": {
        "kind": {
          "const": "cardinality",
          "default": "cardinality",
          "title": "Kind",
          "type": "string"
        },
        "left": {
          "$ref": "#/$defs/KeyRef"
        },
        "relationship": {
          "enum": [
            "one_to_one",
            "one_to_many",
            "many_to_one",
            "many_to_many"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "right": {
          "$ref": "#/$defs/KeyRef"
        }
      },
      "required": [
        "left",
        "right",
        "relationship"
      ],
      "title": "Cardinality",
      "type": "object"
    },
    "CaseConfig": {
      "additionalProperties": false,
      "description": "One reference-versus-candidate verification campaign.",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/CallableSpec"
        },
        "comparison": {
          "$ref": "#/$defs/ComparisonPolicy"
        },
        "generation": {
          "$ref": "#/$defs/GenerationConfig"
        },
        "invocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvocationConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Name",
          "type": "string"
        },
        "performance": {
          "$ref": "#/$defs/PerformanceConfig"
        },
        "reference": {
          "$ref": "#/$defs/CallableSpec"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array",
          "uniqueItems": true
        },
        "timeout_seconds": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "name",
        "reference",
        "candidate"
      ],
      "title": "CaseConfig",
      "type": "object"
    },
    "ColumnSchema": {
      "additionalProperties": false,
      "description": "Portable description of a generated dataframe column.",
      "properties": {
        "categories": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Categories"
        },
        "dtype": {
          "description": "Portable dtype or concrete pandas/Polars dtype name",
          "title": "Dtype",
          "type": "string"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Examples",
          "type": "array"
        },
        "max_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Length"
        },
        "maximum": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "min_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Length"
        },
        "minimum": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "nullable": {
          "default": true,
          "title": "Nullable",
          "type": "boolean"
        },
        "regex": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regex"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "dtype"
      ],
      "title": "ColumnSchema",
      "type": "object"
    },
    "ComparisonOverride": {
      "additionalProperties": false,
      "description": "A comparison-policy patch selected by an output JSON Pointer.",
      "properties": {
        "atol": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atol"
        },
        "column_order": {
          "anyOf": [
            {
              "enum": [
                "strict",
                "ignore"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Order"
        },
        "datetime_tolerance_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Datetime Tolerance Ns"
        },
        "dtype": {
          "anyOf": [
            {
              "enum": [
                "strict",
                "compatible",
                "ignore"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dtype"
        },
        "ignored_columns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ignored Columns"
        },
        "names": {
          "anyOf": [
            {
              "enum": [
                "strict",
                "case_insensitive"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Names"
        },
        "nan_equal": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nan Equal"
        },
        "null_equal": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Null Equal"
        },
        "null_nan_equal": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Null Nan Equal"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "row_keys": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Keys"
        },
        "row_order": {
          "anyOf": [
            {
              "enum": [
                "strict",
                "ignore",
                "keyed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Order"
        },
        "rtol": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rtol"
        },
        "signed_zero_equal": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signed Zero Equal"
        }
      },
      "required": [
        "path"
      ],
      "title": "ComparisonOverride",
      "type": "object"
    },
    "ComparisonPolicy": {
      "additionalProperties": false,
      "description": "Explicit definition of semantic equivalence.",
      "properties": {
        "atol": {
          "default": 0.0,
          "minimum": 0,
          "title": "Atol",
          "type": "number"
        },
        "check_exceptions": {
          "default": true,
          "title": "Check Exceptions",
          "type": "boolean"
        },
        "check_input_mutation": {
          "default": true,
          "title": "Check Input Mutation",
          "type": "boolean"
        },
        "column_order": {
          "default": "strict",
          "enum": [
            "strict",
            "ignore"
          ],
          "title": "Column Order",
          "type": "string"
        },
        "datetime_tolerance_ns": {
          "default": 0,
          "minimum": 0,
          "title": "Datetime Tolerance Ns",
          "type": "integer"
        },
        "dtype": {
          "default": "compatible",
          "enum": [
            "strict",
            "compatible",
            "ignore"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "ignored_columns": {
          "items": {
            "type": "string"
          },
          "title": "Ignored Columns",
          "type": "array"
        },
        "names": {
          "default": "strict",
          "enum": [
            "strict",
            "case_insensitive"
          ],
          "title": "Names",
          "type": "string"
        },
        "nan_equal": {
          "default": true,
          "title": "Nan Equal",
          "type": "boolean"
        },
        "null_equal": {
          "default": true,
          "title": "Null Equal",
          "type": "boolean"
        },
        "null_nan_equal": {
          "default": false,
          "title": "Null Nan Equal",
          "type": "boolean"
        },
        "overrides": {
          "items": {
            "$ref": "#/$defs/ComparisonOverride"
          },
          "maxItems": 1000,
          "title": "Overrides",
          "type": "array"
        },
        "row_keys": {
          "items": {
            "type": "string"
          },
          "title": "Row Keys",
          "type": "array"
        },
        "row_order": {
          "default": "strict",
          "enum": [
            "strict",
            "ignore",
            "keyed"
          ],
          "title": "Row Order",
          "type": "string"
        },
        "rtol": {
          "default": 1e-07,
          "minimum": 0,
          "title": "Rtol",
          "type": "number"
        },
        "signed_zero_equal": {
          "default": true,
          "title": "Signed Zero Equal",
          "type": "boolean"
        }
      },
      "title": "ComparisonPolicy",
      "type": "object"
    },
    "EqualRowCount": {
      "additionalProperties": false,
      "description": "Require selected inputs to contain the same number of rows.",
      "properties": {
        "inputs": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Inputs",
          "type": "array"
        },
        "kind": {
          "const": "equal_row_count",
          "default": "equal_row_count",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "inputs"
      ],
      "title": "EqualRowCount",
      "type": "object"
    },
    "ForeignKey": {
      "additionalProperties": false,
      "description": "Require each non-null child key to occur in the parent input.",
      "properties": {
        "allow_nulls": {
          "default": true,
          "title": "Allow Nulls",
          "type": "boolean"
        },
        "child": {
          "$ref": "#/$defs/KeyRef"
        },
        "kind": {
          "const": "foreign_key",
          "default": "foreign_key",
          "title": "Kind",
          "type": "string"
        },
        "parent": {
          "$ref": "#/$defs/KeyRef"
        }
      },
      "required": [
        "child",
        "parent"
      ],
      "title": "ForeignKey",
      "type": "object"
    },
    "FrameArgument": {
      "additionalProperties": false,
      "description": "One positional or keyword dataframe argument.",
      "properties": {
        "fixture": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture"
        },
        "generate": {
          "default": true,
          "title": "Generate",
          "type": "boolean"
        },
        "kind": {
          "const": "frame",
          "default": "frame",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "FrameArgument",
      "type": "object"
    },
    "FrameSchema": {
      "additionalProperties": false,
      "description": "Schema and domain constraints for generated tabular inputs.",
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnSchema"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "constraints": {
          "items": {
            "discriminator": {
              "mapping": {
                "row_comparison": "#/$defs/RowComparison",
                "sorted_by": "#/$defs/SortedBy"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SortedBy"
              },
              {
                "$ref": "#/$defs/RowComparison"
              }
            ]
          },
          "title": "Constraints",
          "type": "array"
        },
        "max_rows": {
          "default": 30,
          "maximum": 10000,
          "minimum": 0,
          "title": "Max Rows",
          "type": "integer"
        },
        "min_rows": {
          "default": 0,
          "minimum": 0,
          "title": "Min Rows",
          "type": "integer"
        },
        "unique_together": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Unique Together",
          "type": "array"
        }
      },
      "required": [
        "columns"
      ],
      "title": "FrameSchema",
      "type": "object"
    },
    "FrameSequenceArgument": {
      "additionalProperties": false,
      "description": "A homogeneous variable-length sequence of dataframe arguments.",
      "properties": {
        "container": {
          "default": "list",
          "enum": [
            "list",
            "tuple"
          ],
          "title": "Container",
          "type": "string"
        },
        "fixtures": {
          "items": {
            "format": "path",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Fixtures",
          "type": "array"
        },
        "generate": {
          "default": true,
          "title": "Generate",
          "type": "boolean"
        },
        "kind": {
          "const": "frames",
          "default": "frames",
          "title": "Kind",
          "type": "string"
        },
        "max_items": {
          "default": 8,
          "maximum": 256,
          "minimum": 0,
          "title": "Max Items",
          "type": "integer"
        },
        "min_items": {
          "default": 0,
          "maximum": 256,
          "minimum": 0,
          "title": "Min Items",
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "FrameSequenceArgument",
      "type": "object"
    },
    "GenerationConfig": {
      "additionalProperties": false,
      "description": "Deterministic and property-based exploration limits.",
      "properties": {
        "adversarial_examples": {
          "default": true,
          "title": "Adversarial Examples",
          "type": "boolean"
        },
        "deadline_ms": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline Ms"
        },
        "derandomize": {
          "default": false,
          "title": "Derandomize",
          "type": "boolean"
        },
        "generator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator"
        },
        "max_examples": {
          "default": 100,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Examples",
          "type": "integer"
        },
        "max_findings": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Findings",
          "type": "integer"
        },
        "search": {
          "default": true,
          "title": "Search",
          "type": "boolean"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "shrink": {
          "default": true,
          "title": "Shrink",
          "type": "boolean"
        },
        "stability_repeats": {
          "default": 2,
          "maximum": 10,
          "minimum": 1,
          "title": "Stability Repeats",
          "type": "integer"
        },
        "suppress_too_slow": {
          "default": true,
          "title": "Suppress Too Slow",
          "type": "boolean"
        }
      },
      "title": "GenerationConfig",
      "type": "object"
    },
    "InvocationConfig": {
      "additionalProperties": false,
      "description": "The complete shared positional and keyword call contract.",
      "properties": {
        "args": {
          "items": {
            "discriminator": {
              "mapping": {
                "frame": "#/$defs/FrameArgument",
                "frames": "#/$defs/FrameSequenceArgument",
                "json": "#/$defs/JsonArgument"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/FrameArgument"
              },
              {
                "$ref": "#/$defs/JsonArgument"
              },
              {
                "$ref": "#/$defs/FrameSequenceArgument"
              }
            ]
          },
          "maxItems": 256,
          "title": "Args",
          "type": "array"
        },
        "kwargs": {
          "additionalProperties": {
            "discriminator": {
              "mapping": {
                "frame": "#/$defs/FrameArgument",
                "frames": "#/$defs/FrameSequenceArgument",
                "json": "#/$defs/JsonArgument"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/FrameArgument"
              },
              {
                "$ref": "#/$defs/JsonArgument"
              },
              {
                "$ref": "#/$defs/FrameSequenceArgument"
              }
            ]
          },
          "maxProperties": 256,
          "title": "Kwargs",
          "type": "object"
        },
        "relationships": {
          "items": {
            "discriminator": {
              "mapping": {
                "cardinality": "#/$defs/Cardinality",
                "equal_row_count": "#/$defs/EqualRowCount",
                "foreign_key": "#/$defs/ForeignKey",
                "key_overlap": "#/$defs/KeyOverlap"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/KeyOverlap"
              },
              {
                "$ref": "#/$defs/ForeignKey"
              },
              {
                "$ref": "#/$defs/EqualRowCount"
              },
              {
                "$ref": "#/$defs/Cardinality"
              }
            ]
          },
          "title": "Relationships",
          "type": "array"
        },
        "varargs": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameSequenceArgument"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "InvocationConfig",
      "type": "object"
    },
    "JsonArgument": {
      "additionalProperties": false,
      "description": "One fixed or generated JSON-like argument.",
      "properties": {
        "kind": {
          "const": "json",
          "default": "json",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
